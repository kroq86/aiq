#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
PYTHON_BIN="${PYTHON_BIN:-$ROOT/.venv/bin/python}"

cd "$ROOT"
case "${MODEL_MUTATION:-}" in
    "") exec "$PYTHON_BIN" formal/sequence/check.py ;;
    duplicate_sequence_start)
        exec "$PYTHON_BIN" formal/sequence/check.py --mutant duplicate_start
        ;;
    *)
        echo "unknown Sequence mutation: ${MODEL_MUTATION}" >&2
        exit 2
        ;;
esac
